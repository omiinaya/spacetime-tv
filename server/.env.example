# SpacetimeTV — provider credentials
# Copy this file to .env and fill in YOUR provider's values.
# Get the base URL, username and password from your IPTV provider's panel
# (Xtream Codes / XC login). This is what the app uses to fetch channels,
# EPG, movies and series from YOUR provider.

IPTV_BASE=http://your-iptv-provider.example.com:8080
IPTV_USER=your_username
IPTV_PASS=your_password

# TMDB v3 API (optional — get key at https://www.themoviedb.org/settings/api)
# When set, enriches movie metadata and provides trending/popular lists
TMDB_API_KEY=

# Admin authentication for cloud backup and admin endpoints
# Auto-generated as a 64-char hex string on first startup if left empty.
# The generated key is logged to stdout on server start.
# Set to a specific value in production for consistent access.
# ADMIN_API_KEY=

# EPG cache TTL in seconds (default: 3600 = 1 hour)
# EPG_CACHE_TTL=3600

# Path to tmdb-enrich CLI for browserless TMDB metadata extraction
# TMDB_ENRICH_PATH=/path/to/tmdb-enrich

# Request body size limits (bytes)
# MAX_REQUEST_BODY=1048576
# MAX_FILE_UPLOAD=52428800

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Rate limiting (per-IP/device-token, fixed window)
# RATE_WINDOW=60           # Window in seconds
# RATE_SEARCH_LIMIT=300    # Requests per window for /api/v1/search and /api/v1/image-proxy
# RATE_DEFAULT_LIMIT=1000  # Requests per window for all other endpoints
# REDIS_URL=               # Set (e.g. redis://redis:6379/0) to share the rate-limit
#                          # counter across ALL instances (multi-instance deployments).
#                          # Unset (default) keeps the in-process per-IP counter.

# Credential encryption at rest for stored provider credentials
# ENCRYPT_CREDENTIALS=false     # true to encrypt provider passwords at rest
# STV_ENCRYPT_KEY=             # 32-byte AES key for the above (else auto-generated)

# EPG + cache paths / runtime dirs
# EPG_CACHE_FILE=server/epg_cache.json
# STATIC_DIR=web/dist
# STV_DATA_DIR=server/data

# Cache warming (background pre-fetch of VOD + Series + EPG at startup)
# CACHE_WARM_ENABLED=true
# CACHE_WARM_CONCURRENCY=50
# CACHE_WARM_CATEGORIES=          # comma-separated category filter (empty = all)

# Cache cleanup / TTL (wired into runtime)
# CACHE_TTL_HOURS=2             # stale cache-entry cutoff (hours)
# CLEANUP_INTERVAL=600          # seconds between cleanup sweeps

# Profile token secret (used to derive per-profile device tokens)
# PROFILE_TOKEN_SECRET=

# Enable HTTPS redirect (default: true)
ENFORCE_HTTPS=true

# LAN auth bypass (default: true = dev convenience)
# When true, requests from localhost / private networks (RFC1918: 10.x,
# 172.16-31.x, 192.168.x) skip X-Admin-Key / X-Device-Token checks for all
# /api/ endpoints. Set to false for hardened deployments where every request
# (including LAN) must authenticate.
# ALLOW_LAN_BYPASS=true
# Additional exact-match hosts exempt from auth while the bypass is on
# (default: 127.0.0.1,::1,localhost). Private subnets are exempt by prefix.
# LAN_BYPASS_HOSTS=127.0.0.1,::1,localhost

# Serve host (IP or domain) — when set, http:// and https:// CORS origins
# for the standard ports (5180/5183/8720/8722) are added to the allowlist
# automatically. Set to the address you open the dashboard on (e.g. your
# server's LAN IP or public domain). Leave empty for localhost-only use.
# STV_HOST=192.0.2.10

# Stream preflight tuning (CDN check before committing a 200)
# STREAM_PREFLIGHT_TIMEOUT=10        # per-call timeout (seconds)
# STREAM_PREFLIGHT_SUCCESS_TTL=30    # success cache TTL (seconds)
# STREAM_PREFLIGHT_FAILURE_TTL=5     # failure cache TTL (seconds)

# Multiple providers (JSON array — overrides IPTV_BASE/USER/PASS)
# Each entry: {"name":"Provider1","base_url":"...","username":"...","password":"...","enabled":true}
# PROVIDERS_JSON=[{"name":"My Provider","base_url":"http://example.com:8080","username":"user","password":"pass"}]

# CDN for static assets (optional, e.g., https://cdn.example.com)
# VITE_CDN_URL=
