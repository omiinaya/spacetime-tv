# SpacetimeTV — provider credentials
# Copy this file to .env and fill in your values

IPTV_BASE=http://iptv-provider.example.com
IPTV_USER=your_username
IPTV_PASS=your_password

# TMDB v3 API (optional — get key at https://www.themoviedb.org/settings/api)
# When set, enriches movie metadata and provides trending/popular lists
TMDB_API_KEY=

# Admin authentication for cloud backup and admin endpoints
# Auto-generated as a 64-char hex string on first startup if left empty.
# The generated key is logged to stdout on server start.
# Set to a specific value in production for consistent access.
# ADMIN_API_KEY=

# EPG cache TTL in seconds (default: 3600 = 1 hour)
# EPG_CACHE_TTL=3600

# Path to tmdb-enrich CLI for browserless TMDB metadata extraction
# TMDB_ENRICH_PATH=/path/to/tmdb-enrich

# Request body size limits (bytes)
# MAX_REQUEST_BODY=1048576
# MAX_FILE_UPLOAD=52428800

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Rate limiting (per-IP, fixed window)
# RATE_WINDOW=60           # Window in seconds
# RATE_SEARCH_LIMIT=100    # Requests per window for /api/v1/search and /api/v1/image-proxy
# RATE_DEFAULT_LIMIT=1000  # Requests per window for all other endpoints

# Enable HTTPS redirect (default: true)
ENFORCE_HTTPS=true
