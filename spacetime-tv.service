[Unit]
Description=Spacetime-TV — IPTV Cable Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hindsight
Group=hindsight
ExecStart=/home/user/chappy/.venv/bin/python3 /home/user/spacetime-tv/server/main.py
WorkingDirectory=/home/user/spacetime-tv
Environment="HOME=/home/user"
Environment="PATH=/home/user/chappy/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="VIRTUAL_ENV=/home/user/chappy/.venv"
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
