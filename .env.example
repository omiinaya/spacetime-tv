# SpacetimeTV — environment configuration
# Copy this file to .env and fill in your values.
# For detailed config, see server/.env.example

# IPTV provider — set these to YOUR provider's Xtream Codes details
# (base URL, username, password from your IPTV provider's panel)
IPTV_BASE=http://your-iptv-provider.example.com:8080
IPTV_USER=your_username
IPTV_PASS=your_password

# Multiple providers (JSON array — overrides IPTV_BASE/USER/PASS)
# Each entry: {"name":"Provider1","base_url":"...","username":"...","password":"...","enabled":true}
# Configured in the Settings menu → IPTV Providers, and written back here
# as PROVIDERS_JSON so creds/endpoints survive data-dir wipes / restarts.
PROVIDERS_JSON=[{"name":"My Provider","base_url":"http://example.com:8080","username":"user","password":"pass"}]

# TMDB v3 API (optional)
TMDB_API_KEY=

# Cache
EPG_CACHE_TTL=3600

# Rate limiting (per-IP, fixed window)
RATE_WINDOW=60           # Window in seconds
RATE_SEARCH_LIMIT=100    # Requests per window for /api/v1/search and /api/v1/image-proxy
RATE_DEFAULT_LIMIT=1000  # Requests per window for all other endpoints

# CDN for static assets (optional, e.g., https://cdn.example.com)
VITE_CDN_URL=

# ACME / Let's Encrypt (optional — set these to get real CA certs via HTTPS)
# If left empty, the container falls back to self-signed certificate
ACME_DOMAIN=
ACME_EMAIL=
ACME_STAGING=false

# LAN auth bypass (default: true = dev convenience)
# When true, requests from localhost / private networks (RFC1918: 10.x,
# 172.16-31.x, 192.168.x) skip X-Admin-Key / X-Device-Token checks for all
# /api/ endpoints. Set to false for hardened deployments where every request
# (including LAN) must authenticate.
# ALLOW_LAN_BYPASS=true
# Additional exact-match hosts exempt from auth while the bypass is on
# (default: 127.0.0.1,::1,localhost). Private subnets are exempt by prefix.
# LAN_BYPASS_HOSTS=127.0.0.1,::1,localhost

# Serve host (IP or domain) — when set, http:// and https:// CORS origins
# for the standard ports (5180/5183/8720/8722) are added to the allowlist
# automatically. Set to the address you open the dashboard on (e.g. your
# server's LAN IP or public domain). Leave empty for localhost-only use.
# STV_HOST=192.0.2.10

# Stream preflight tuning (CDN check before committing a 200)
# STREAM_PREFLIGHT_TIMEOUT=10        # per-call timeout (seconds)
# STREAM_PREFLIGHT_SUCCESS_TTL=30    # success cache TTL (seconds)
# STREAM_PREFLIGHT_FAILURE_TTL=5     # failure cache TTL (seconds)

# Admin authentication for cloud backup and admin endpoints
# Auto-generated as a 64-char hex string on first startup if left empty.
# ADMIN_API_KEY=

# Request body size limits (bytes)
# MAX_REQUEST_BODY=1048576
# MAX_FILE_UPLOAD=52428800

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
